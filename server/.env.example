# Memoryz Go server — local development settings. Copy to server/.env and load it with your shell
# (the binary reads the environment only; nothing here is read from a file in production).

ENV=development
HOST=127.0.0.1
PORT=8080
# Public origin: cookies are Secure on https, OAuth callbacks are APP_URL/api/auth/<provider>/callback.
APP_URL=http://127.0.0.1:8080
LOG_LEVEL=info
LOG_FORMAT=text

# Local Postgres (the dedicated development database). In the cloud DB_INSTANCE replaces this.
DATABASE_URL=postgresql://memoryz:memoryz_local_only@127.0.0.1:15444/memoryz
# Cloud SQL instead of a URL: project:region:instance, an IAM database user, private IP from Cloud Run.
# DB_INSTANCE=memoryz-prod:asia-northeast3:memoryz-pg
# DB_USER=memoryz-run@memoryz-prod.iam
# DB_NAME=memoryz
# DB_IAM_AUTH=true
# DB_IP_TYPE=private
DB_POOL_MAX=6
MIGRATE_ON_START=false

# Files: pg keeps bytes in Postgres (ops.blob); gcs uses a bucket with Application Default Credentials.
BLOB_STORE=pg
# GCS_BUCKET=memoryz-prod-uploads

# Cache: empty uses an in-process cache; the cloud service points at Memorystore for Valkey.
# VALKEY_ADDR=10.0.0.3:6379

# The web build to serve on the same origin (Next.js `output: 'export'`). Empty serves the API only.
# STATIC_DIR=../web/out

# Sample accounts. Never on in a public deployment except for the PoC's demo sign-in.
DEMO_MODE=true
DEMO_ADMIN=false

# 32+ random bytes; signs the short-lived login state cookie. Unset in development uses a fixed dev value.
# AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI (OpenRouter). Leave the key empty to run without AI (rule-based planner and grading).
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_PROVIDER_ORDER=amazon-bedrock/us-east-1,openai/fast

PDF_WORKERS=2
AI_CONCURRENCY=16
