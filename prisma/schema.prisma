generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PARENT
  ADMIN
}

enum Bucket {
  AGAIN
  HARD
  GOOD
  EASY
  MASTERED
}

enum CardType {
  CONCEPT
  RELATION
  COMPARISON
  BLIND
}

enum ScheduleKind {
  FIXED
  FLEXIBLE
}

model User {
 communityPosts CommunityPost[]
 communityComments CommunityComment[]
 communityActions CommunityAction[]
 communityRewards CommunityReward[]
 communityPrivacy CommunityPrivacy?
 communityFollowEvents CommunityFollowEvent[]
 communitySavedQuestions CommunitySavedQuestion[]
 communityCardClones CommunityCardClone[]
  id                String @id @default(cuid())
  name              String
  nickname          String @unique
  role              Role
  school            String @default("")
  grade             String @default("")
  streak            Int @default(0)
  points            Int @default(0)
  suspended         Boolean @default(false)
  selectedChildId   String?
  srsMode           String @default("FIXED")
  desiredRetention  Float @default(0.9)
  privacy           Json @default("{\"accuracy\":true,\"time\":true,\"wrongNotes\":false}")
  completedSubjects String[] @default([])
  linkFailures      Int @default(0)
  linkLockedUntil   DateTime?
  createdAt         DateTime @default(now())
  sessions          Session[]
  subjects          Subject[]
  materials         Material[]
  questions         Question[]
  essays            Essay[]
  attempts          Attempt[]
  cards             Card[]
  cardReviews       CardReview[]
  schedules         Schedule[]
  posts             Post[]
  comments          Comment[]
  likes             PostLike[]
  saves             PostSave[]
  reports           Report[]
  blocks            Block[] @relation("blocker")
  blockedBy         Block[] @relation("blocked")
  invites           Invite[]
  children          ParentLink[] @relation("parent")
  parents           ParentLink[] @relation("student")
  sentCheers        Cheer[] @relation("cheerSender")
  cheers            Cheer[] @relation("cheerRecipient")
  notifications     Notification[]
  followers         Follow[] @relation("following")
  following         Follow[] @relation("follower")
  sentMessages      Message[] @relation("messageSender")
  receivedMessages  Message[] @relation("messageRecipient")
  uploads           Upload[]
  oauthAccounts     OAuthAccount[]
  accountOnboarding AccountOnboarding?
  aiRuns            AiRun[]
  explanationReports ExplanationReport[]
}

model AccountOnboarding {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft Json @default("{}")
  completedAt DateTime?
  updatedAt DateTime @default(now())
}

model Session {
  id        String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Subject {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String @default("book")
  semester  String @default("2026년 2학기")
  color     String @default("orange")
  examName  String?
  examDate  String?
  deleted   Boolean @default(false)
  createdAt DateTime @default(now())
  materials Material[]
  questions Question[]
  essays    Essay[]
  cards     Card[]
  @@index([userId, deleted])
}

model Material {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  content   String @db.Text
  type      String @default("TXT")
  url       String?
  /// The uploaded file this material was read from; its bytes and images live with the upload.
  uploadId  String? @unique
  upload    Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  /// Offsets in content where each page starts; empty when the text no longer matches the file.
  pageBreaks Int[] @default([])
  /// How content was produced: pdf-text, pdf-ocr, pdf-mixed, text, image-ocr or manual.
  extraction String?
  /// sha256 of content and its first 160 characters, kept by the server when the text changes.
  contentHash String @default("")
  excerpt     String @default("")
  createdAt DateTime @default(now())
  questions Question[]
  essays    Essay[]
  cards     Card[]
  @@index([subjectId])
  @@index([userId, subjectId])
}

model Question {
 communitySaved CommunitySavedQuestion?
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  prompt      String @db.Text
  options     String[]
  answer      Int
  explanation String @db.Text
  learningExplanation Json?
  citation    String @db.Text
  past        String
  future      String
  explanationReports ExplanationReport[]
  attempts    Attempt[]
  @@index([subjectId])
  @@index([materialId])
  @@index([userId, subjectId])
}

model Essay {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  prompt      String @db.Text
  keywords    String[]
  distractors String[]
  modelAnswer String @db.Text
  citation    String @db.Text
  attempts    Attempt[]
  @@index([subjectId])
  @@index([materialId])
  @@index([userId, subjectId])
}

model ExplanationReport {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  nodeId String @default("")
  reason String
  createdAt DateTime @default(now())
  @@unique([userId, questionId, nodeId, reason])
  @@index([questionId])
}

model Attempt {
  id         String @id @default(cuid())
  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  essayId    String?
  essay      Essay? @relation(fields: [essayId], references: [id], onDelete: Cascade)
  requestId String?
  responseMs Int?
  beatsSeen Int @default(0)
  explainDepth String?
  microResult String?
  divergenceNodeId String?
  @@unique([userId, requestId])
  answer     String @db.Text
  correct    Boolean
  score      Int
  createdAt  DateTime @default(now())
  @@index([questionId])
  @@index([essayId])
  @@index([userId, createdAt])
}

model Card {
 community CommunityCard?
 communitySourceClones CommunityCardClone[] @relation("communitySourceCard")
 communityCloneSources CommunityCardClone[] @relation("communityClonedCard")
  id              String @id @default(cuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  front           String @db.Text
  back            String @db.Text
  type            CardType @default(CONCEPT)
  bucket          Bucket @default(AGAIN)
  consecutiveEasy Int @default(0)
  nextReviewAt    DateTime @default(now())
  deleted         Boolean @default(false)
  image           String?
  masks           Json @default("[]")
  sourceKind String @default("TEXT")
  diagram Json?
  maskedNodeIds String[] @default([])
  sourceDiagramId String?
  sourceQuestionId String?
  materialId      String?
  material        Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  fsrs            Json?
  createdAt       DateTime @default(now())
  reviews         CardReview[]
  @@index([subjectId])
  @@index([materialId])
  @@unique([userId, sourceQuestionId, sourceKind])
  @@index([userId, deleted, nextReviewAt])
}

model CardReview {
  id        String @id
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating    String
  result    Json
  createdAt DateTime @default(now())
  @@index([cardId])
  @@index([userId, createdAt])
}

model Schedule {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String
  start     String
  end       String
  kind      ScheduleKind
  subjectId String?
  done      Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([subjectId])
  @@index([userId, date])
}

model Post {
 community CommunityPost?
 communityActions CommunityAction[]
 communityRewards CommunityReward[]
 communitySavedQuestions CommunitySavedQuestion[]
  school    String @default("")
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  category  String
  title     String
  body      String @db.Text
  anonymous Boolean @default(false)
  createdAt DateTime @default(now())
  comments  Comment[]
  likes     PostLike[]
  saves     PostSave[]
  reports   Report[]
  @@index([userId])
  @@index([role, createdAt])
  @@index([role, school, createdAt(sort: Desc)])
}

model Comment {
 community CommunityComment?
  id        String @id @default(cuid())
  postId    String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  parentId  String?
  parent    Comment? @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("replies")
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([postId, createdAt])
}

model PostLike {
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
  @@id([userId, postId])
}

model PostSave {
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId])
  @@id([userId, postId])
}

model Report {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reason    String
  status    String @default("OPEN")
  createdAt DateTime @default(now())
  @@index([postId])
  @@unique([userId, postId])
}

model Block {
  userId    String
  user      User @relation("blocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@index([blockedId])
  @@id([userId, blockedId])
}

model Invite {
  code      String @id
  studentId String
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([studentId])
}

model ParentLink {
  parentId  String
  parent    User @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([studentId])
  @@id([parentId, studentId])
}

model Cheer {
  id          String @id @default(cuid())
  senderId    String
  sender      User @relation("cheerSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User @relation("cheerRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  message     String
  points      Int @default(0)
  thanked     Boolean @default(false)
  createdAt   DateTime @default(now())
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean @default(false)
  href      String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Follow {
  followerId String
  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  @@index([followingId])
  @@id([followerId, followingId])
}

model Message {
  id String @id @default(cuid())
  senderId String
  sender User @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient User @relation("messageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
  @@index([recipientId, senderId, createdAt])
  @@index([senderId, recipientId, createdAt])
}

model School {
  id String @id @default(cuid())
  name String @unique
}

model Upload {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime String
  name String
  size Int
  sha256 String?
  pages Int?
  pageBreaks Int[] @default([])
  extraction String?
  /// sha256 of the extracted text, to tell whether a material still holds it unedited.
  textHash String?
  createdAt DateTime @default(now())
  images UploadImage[]
  material Material?
  @@index([userId, createdAt])
}
/// An image embedded in an uploaded PDF, with where it appeared. Its bytes live in the blob store
/// (ops.blob locally, Cloud Storage in the cloud) under uploads/<uploadId>/images/<id>.
model UploadImage {
  id String @id @default(cuid())
  uploadId String
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  page Int
  order Int
  /// Global index of the paragraph it follows in the extracted text; -1 before any text.
  paragraph Int
  /// Offset in the extracted text where it belongs.
  anchor Int
  x Float
  y Float
  w Float
  h Float
  width Int
  height Int
  mime String
  /// Start of the paragraph it follows, to find its place again after the text is edited.
  context String @default("")
  @@index([uploadId, page, order])
}

model OAuthAccount {
  id String @id @default(cuid())
  provider String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerId])
}

model AiRun {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  kind String
  inputHash String
  skillVersion String
  model String
  status String @default("RUNNING")
  result Json?
  steps Json @default("[]")
  error String?
  errorStatus Int?
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  finishedAt DateTime?
  @@unique([userId, requestId])
  @@index([userId, status, updatedAt])
}

model CommunityPost {
  postId String @id
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks Json @default("[]")
  tags Json @default("{}")
  sourceRef Json?
  requestId String?
  deleted Boolean @default(false)
  editedAt DateTime? @db.Timestamp(3)
  solvedAt DateTime? @db.Timestamp(3)
  acceptedCommentId String?
  @@unique([userId, requestId])
}
model CommunityComment {
  commentId String @id
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  block Json?
  requestId String?
  @@unique([userId, requestId])
}
model CommunityAction {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  blockId String
  kind String
  result Json
  createdAt DateTime @default(now()) @db.Timestamp(3)
  @@id([userId, postId, blockId, kind])
}
model CommunityReward {
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  @@id([postId, userId])
}
model CommunityPrivacy {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibility Json @default("{\"grade\":true,\"subjects\":true,\"followerCount\":false,\"cardsDefault\":false,\"whoCanFollow\":\"SAME_GRADE\"}")
}
model CommunityCard {
  cardId String @id
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  public Boolean @default(false)
}
model CommunityFollowEvent {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  @@index([userId, createdAt], map: "CommunityFollowEvent_user_created_idx")
}
model CommunitySavedQuestion {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String @id
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}
model CommunityCardClone {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceCardId String
  sourceCard Card @relation("communitySourceCard", fields: [sourceCardId], references: [id], onDelete: Cascade)
  cardId String
  card Card @relation("communityClonedCard", fields: [cardId], references: [id], onDelete: Cascade)
  @@id([userId, sourceCardId])
}
