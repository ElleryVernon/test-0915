    "/var/folders/z0/1vqg6kys5t74k2zxq11x31fh0000gn/T/memoryz-devproxy-VZ5ym1/next-dist/dev/types/**/*.ts",
    "/var/folders/z0/1vqg6kys5t74k2zxq11x31fh0000gn/T/memoryz-devproxy-msWLMS/next-dist/types/**/*.ts",
    "/var/folders/z0/1vqg6kys5t74k2zxq11x31fh0000gn/T/memoryz-devproxy-msWLMS/next-dist/dev/types/**/*.ts",
    "/var/folders/z0/1vqg6kys5t74k2zxq11x31fh0000gn/T/memoryz-devproxy-PD3UHF/next-dist/types/**/*.ts",
    "/var/folders/z0/1vqg6kys5t74k2zxq11x31fh0000gn/T/memoryz-devproxy-PD3UHF/next-dist/dev/types/**/*.ts"
  ],
  "exclude": [
