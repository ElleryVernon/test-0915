DATABASE_URL="postgresql://memoryz:memoryz_local_only@127.0.0.1:15444/memoryz"
# Explicit opt-in to local sample accounts. Disable for public deployment.
DEMO_MODE="false"
APP_URL="http://localhost:3000"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-5.6-luna"
OPENROUTER_REASONING_EFFORT="high"
# Optional model used only for blind solving and semantic generation review.
# Empty keeps the generation model. Evaluate quality, latency and cost before enabling.
OPENROUTER_QUALITY_MODEL=""
AI_QUALITY_REVIEW="true"
# TypeSafe Jev judgment model: runs beside the generator for essay grading and generation review.
# AI_JUDGE=off (default) never calls it; shadow records verdicts only; on lets an agreeing verdict replace
# the separate review call and serves quick keyword marks (POST /api/essay/judge).
TYPESAFE_API_KEY=""
TYPESAFE_MODEL="jev-latest"
AI_JUDGE="off"
# Use json_schema for Baseten GLM; it does not support forced function calls.
OPENROUTER_STRUCTURED_MODE="function"
# Providers tried in order, no others. Default: OpenAI fast, then Bedrock us-east-1 (docs/SERVER.md, AI).
OPENROUTER_PROVIDER_ORDER="openai/fast,amazon-bedrock/us-east-1"
# OAuth callbacks: APP_URL/api/auth/{provider}/callback
# A random 32+ byte server-only value signs short-lived login state cookies.
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
# Sign in with Apple client secret is an ES256 JWT, rotated before expiration.
APPLE_CLIENT_SECRET=""
